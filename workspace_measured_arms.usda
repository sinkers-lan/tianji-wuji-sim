#usda 1.0
(
    defaultPrim = "Workspace"
    doc = "PI05 startup poses. Right arm uses the first-frame joint-wise median of 53 recorded LeRobot episodes. Left arm is reflected across the robot sagittal plane. Finger joints retain the source asset pose."
