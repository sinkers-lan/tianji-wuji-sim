#usda 1.0
(
    defaultPrim = "Workspace"
    metersPerUnit = 1
    subLayers = [
        @workspace_pi05.usda@
    ]
    upAxis = "Z"
)

over "Workspace"
{
    over "Environment"
    {
        def Camera "HeadRGB" (
            prepend apiSchemas = ["OmniLensDistortionOpenCvPinholeAPI", "OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
        )
        {
            float2 clippingRange = (0.04, 10)
            float exposure:fStop = 5
            float exposure:responsivity = 1.1026709
            float exposure:time = 0.02
            float horizontalAperture = 104.82592
            token omni:lensdistortion:model = "opencvPinhole"
            float omni:lensdistortion:opencvPinhole:cx = 638.60547
            float omni:lensdistortion:opencvPinhole:cy = 362.07568
            float omni:lensdistortion:opencvPinhole:fx = 610.536
            float omni:lensdistortion:opencvPinhole:fy = 610.7573
