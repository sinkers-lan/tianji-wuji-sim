#usda 1.0
(
    defaultPrim = "Workspace"
    doc = "PI05 impedance scene with a built-in PhysX control graph."
    metersPerUnit = 1
    subLayers = [
        @workspace_pi05_impedance.usda@
    ]
    upAxis = "Z"
)

over "Workspace"
{
    def OmniGraph "Pi05Control"
    {
        custom token evaluator:type = "execution"
        custom token fabricCacheBacking = "Shared"
        custom int2 fileFormatVersion = (1, 6)
        custom token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "OnTick"
        {
            custom bool inputs:onlyPlayback = 0
            custom token node:type = "omni.graph.action.OnTick"
            custom int node:typeVersion = 1
            custom uint outputs:tick
        }

        def OmniGraphNode "Impedance"
        {
            custom double[] inputs:dampingRatios = [0.3, 0.3, 0.3, 0.2, 0.2, 0.2, 0.2]
            custom uint inputs:execIn
            prepend uint inputs:execIn.connect = </Workspace/Pi05Control/OnTick.outputs:tick>
            custom string inputs:script = '''"""Source embedded as text in the USD Action Graph."""
import numpy as np
import omni.physics.core
import omni.physics.tensors as tensors
import omni.usd


def initialize(state, context, ratios):
    sim = tensors.create_simulation_view("numpy", stage_id=context.get_stage_id())
    art = sim.create_articulation_view("/Workspace/Robot/Base")
    if art.count != 1 or art.max_dofs != 54:
        return False
    joint_names = [f"Joint{i}_{side}" for side in "LR" for i in range(1, 8)]
    indices = [art.shared_metatype.dof_names.index(name) for name in joint_names]
    stiffness = art.get_dof_stiffnesses()[0, indices]
    mass_matrix = art.get_generalized_mass_matrices()[0]
    inertia = 1 / np.diag(np.linalg.inv(mass_matrix))[indices]
    damping = art.get_dof_dampings().copy()
    damping[0, indices] = 2 * np.tile(ratios, 2) * np.sqrt(stiffness * inertia)
    state.articulation_indices = np.array([0], dtype=np.int32)
    art.set_dof_dampings(damping, state.articulation_indices)
    state.sim = sim
    state.art = art
    state.arm_indices = indices
    state.efforts = np.zeros_like(art.get_gravity_compensation_forces())
    print("PI05_USD_CONTROL_ACTIVE", flush=True)
    return True


def apply_control(state):
    if state.context.get_stage() != state.stage:
        return
    art = getattr(state, "art", None)
    if art is None or not art.check():
        if not initialize(state, state.context, state.ratios):
            return
        art = state.art
    inds = state.arm_indices
    state.efforts[0, inds] = art.get_gravity_compensation_forces()[0, inds]
    art.set_dof_actuation_forces(state.efforts, state.articulation_indices)


def compute(db):
    state = db.per_instance_state
    if getattr(state, "pre_step", None) is None:
        state.context = omni.usd.get_context()
        state.stage = state.context.get_stage()
        state.ratios = np.asarray(db.inputs.dampingRatios).copy()
        state.physics = omni.physics.core.get_physics_simulation_interface()
        state.pre_step = state.physics.subscribe_physics_on_step_events(
            pre_step=True, order=0, on_update=lambda _dt, _context: apply_control(state)
        )
    return True


def cleanup(db):
    state = db.per_instance_state
    state.pre_step = None
    state.art = state.sim = None
'''
            custom token node:type = "omni.graph.scriptnode.ScriptNode"
            custom int node:typeVersion = 1
        }
    }
}
